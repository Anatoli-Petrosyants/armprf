---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localizePath, useTranslations } from '@/lib/i18n';

// A single 404 for both languages: GitHub Pages serves one file for every
// unmatched path, so it shows English first with the Armenian line beneath.
const en = useTranslations('en');
const hy = useTranslations('hy');
---

<BaseLayout lang="en" neutral="/404" title={en('404.title')} description={en('404.body')} noindex={true}>
  <section class="moa-grid">
    <div class="wrap grid min-h-[60dvh] place-items-center py-20 text-center">
      <div>
        <p class="tnum text-[clamp(5rem,18vw,10rem)] font-bold leading-none text-[var(--color-accent-text)]">404</p>
        <h1 class="mt-4 text-3xl">{en('404.title')}</h1>
        <p class="mt-3 text-[var(--color-muted)]">{en('404.body')}</p>
        <p class="mt-1 text-sm text-[var(--color-faint)]">{hy('404.body')}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={localizePath('/', 'en')} class="btn btn-primary">{en('404.home')}</a>
          <a href={localizePath('/', 'hy')} class="btn btn-ghost">{hy('404.home')}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

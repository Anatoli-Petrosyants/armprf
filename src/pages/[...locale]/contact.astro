---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import { localePaths, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { breadcrumbLd } from '@/lib/seo';
import { site, socialLinks } from '@/lib/site';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const subject = encodeURIComponent(lang === 'hy' ? 'Հարցում ARMPRF-ին' : 'Enquiry for ARMPRF');
const mailto = `mailto:${site.contact.email}?subject=${subject}`;
---

<BaseLayout
  lang={lang}
  neutral="/contact"
  title={t('contact.title')}
  description={lang === 'hy'
    ? 'Կապ ARMPRF-ի հետ՝ էլ. փոստ, հեռախոս, սոցիալական ցանցեր և հրաձգարանի գտնվելու վայրը։'
    : 'Get in touch with ARMPRF — email, phone, social channels and where we shoot.'}
  jsonLd={[breadcrumbLd([{ name: t('contact.title'), url: localizePath('/contact', lang) }])]}
>
  <PageHeader lang={lang} title={t('contact.title')} crumbs={[{ name: t('contact.title'), path: '/contact' }]} />

  <Section>
    <div class="grid gap-4 md:grid-cols-3">
      <div class="card p-6">
        <h2 class="eyebrow">{t('contact.email')}</h2>
        <p class="mt-3 text-lg">
          <a href={mailto} class="hover:text-[var(--color-accent)]">{site.contact.email}</a>
        </p>
        <a href={mailto} class="btn btn-primary mt-5">{t('contact.write')}</a>
        {site.flags.showContactForm && (
          <a href={site.forms.contact} rel="noopener" class="btn btn-ghost mt-3 w-full">{t('contact.form')}</a>
        )}
      </div>

      <div class="card p-6">
        <h2 class="eyebrow">{t('contact.phone')}</h2>
        <p class="mt-3 text-lg">
          <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="hover:text-[var(--color-accent)]">
            {site.contact.phoneDisplay}
          </a>
        </p>
      </div>

      <div class="card p-6">
        <h2 class="eyebrow">{t('contact.social')}</h2>
        <ul class="mt-3 grid gap-2">
          {socialLinks.map((link) => (
            <li>
              <a href={link.url} rel="me noopener" class="text-[var(--color-muted)] hover:text-[var(--color-accent)]">
                {link.label} ↗
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section eyebrow={t('contact.location')} title={site.contact.address[lang]}>
    <div class="card overflow-hidden">
      <iframe
        src={site.contact.mapEmbedUrl}
        title={t('contact.location')}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="aspect-[16/9] w-full border-0"
      ></iframe>
    </div>
    <a href={site.contact.mapLinkUrl} rel="noopener" class="btn btn-ghost mt-4">{t('events.map')} ↗</a>
  </Section>
</BaseLayout>

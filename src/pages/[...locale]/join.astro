---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import { localePaths, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { breadcrumbLd } from '@/lib/seo';
import { site } from '@/lib/site';
import membership from '@/content/config/membership.json';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  neutral="/join"
  title={t('join.title')}
  description={membership.note[lang]}
  jsonLd={[breadcrumbLd([{ name: t('join.title'), url: localizePath('/join', lang) }])]}
>
  <PageHeader
    lang={lang}
    title={t('join.title')}
    lead={membership.note[lang]}
    crumbs={[{ name: t('join.title'), path: '/join' }]}
  />

  <Section eyebrow={t('join.tiers')}>
    <ul class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {membership.tiers.map((tier) => (
        <li class={`card flex flex-col p-6 ${tier.featured ? 'border-[var(--color-accent)]' : ''}`}>
          <h2 class="text-xl">{tier.name[lang]}</h2>
          <p class="tnum mt-3 text-2xl font-bold text-[var(--color-accent)]">{tier.price.display[lang]}</p>
          <p class="eyebrow mt-6">{t('join.perks')}</p>
          <ul class="mt-3 grid flex-1 gap-2 text-sm text-[var(--color-muted)]">
            {tier.perks[lang].map((perk) => (
              <li class="flex gap-2">
                <span aria-hidden="true" class="text-[var(--color-accent)]">✓</span>
                <span>{perk}</span>
              </li>
            ))}
          </ul>
          <a
            href={site.forms.membership}
            rel="noopener"
            class={`btn mt-6 w-full ${tier.featured ? 'btn-primary' : 'btn-ghost'}`}
          >
            {t('join.apply')}
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section
    eyebrow={lang === 'hy' ? 'Պահանջներ' : 'Requirements'}
    title={lang === 'hy' ? 'Ինչ է անհրաժեշտ' : 'What you need'}
    class="moa-grid"
  >
    <ul class="grid gap-2 md:grid-cols-2">
      {membership.requirements[lang].map((item) => (
        <li class="card flex items-start gap-3 p-4 text-sm">
          <span aria-hidden="true" class="mt-0.5 text-[var(--color-accent)]">•</span>
          <span class="text-[var(--color-muted)]">{item}</span>
        </li>
      ))}
    </ul>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={site.forms.membership} rel="noopener" class="btn btn-primary">{t('join.apply')}</a>
      <a href={localizePath('/getting-started', lang)} class="btn btn-ghost">{t('nav.gettingStarted')}</a>
    </div>
  </Section>
</BaseLayout>

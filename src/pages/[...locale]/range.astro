---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import Timeline from '@/components/Timeline.astro';
import { localePaths, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { breadcrumbLd } from '@/lib/seo';
import range from '@/content/config/range.json';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const labels = {
  done: lang === 'hy' ? 'Արված' : 'Done',
  'in-progress': lang === 'hy' ? 'Ընթացքում' : 'In progress',
  planned: lang === 'hy' ? 'Ծրագրված' : 'Planned',
};

const statusStyles: Record<string, string> = {
  done: 'border-[var(--color-accent)] text-[var(--color-accent)]',
  'in-progress': 'border-[var(--color-border-strong)] text-[var(--color-ink)]',
  planned: 'border-[var(--color-border)] text-[var(--color-faint)]',
};
---

<BaseLayout
  lang={lang}
  neutral="/range"
  title={t('range.title')}
  description={range.intro[lang]}
  jsonLd={[breadcrumbLd([{ name: t('range.title'), url: localizePath('/range', lang) }])]}
>
  <PageHeader
    lang={lang}
    title={t('range.title')}
    lead={range.intro[lang]}
    crumbs={[{ name: t('range.title'), path: '/range' }]}
  >
    <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
      {range.specs.map((spec) => (
        <div>
          <dt class="text-[0.625rem] uppercase tracking-[0.14em] text-[var(--color-faint)]">{spec.label[lang]}</dt>
          <dd class="tnum mt-1 text-xl font-bold text-[var(--color-accent)]">{spec.value}</dd>
        </div>
      ))}
    </dl>
  </PageHeader>

  <Section eyebrow={t('range.progress')} title={t('range.progress')}>
    <Timeline lang={lang} entries={range.timeline as never} labels={labels} />
  </Section>

  <Section eyebrow={t('range.facilities')} title={t('range.facilities')} class="moa-grid">
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {range.facilities.map((facility) => (
        <li class="card flex items-center justify-between gap-3 p-4">
          <span class="text-sm">{facility.title[lang]}</span>
          <span class={`tag ${statusStyles[facility.status]}`}>{labels[facility.status as keyof typeof labels]}</span>
        </li>
      ))}
    </ul>
  </Section>
</BaseLayout>

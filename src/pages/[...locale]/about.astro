---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import SmartImage from '@/components/SmartImage.astro';
import { localePaths, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { breadcrumbLd } from '@/lib/seo';
import { site } from '@/lib/site';
import about from '@/content/config/about.json';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  neutral="/about"
  title={t('nav.about')}
  description={about.intro[lang]}
  jsonLd={[breadcrumbLd([{ name: t('nav.about'), url: localizePath('/about', lang) }])]}
>
  <PageHeader lang={lang} title={t('nav.about')} lead={about.intro[lang]} crumbs={[{ name: t('nav.about'), path: '/about' }]} />

  <Section eyebrow={about.membership.org} title={about.membership.title[lang]} id="membership">
    <div class="card grid gap-8 p-6 md:p-8 lg:grid-cols-[1fr_26rem] lg:items-start">
      <div>
        <p class="text-lg leading-relaxed text-[var(--color-muted)]">{about.membership.body[lang]}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={localizePath(`/blog/${about.membership.postSlug}`, lang)} class="btn btn-ghost">
            {t('common.readMore')}
          </a>
          <a href={about.membership.url} rel="noopener" class="btn btn-ghost">{about.membership.org} ↗</a>
        </div>
      </div>

      {/* The confirmation letter is a document, so it keeps its own aspect
          ratio rather than being cropped to a card shape. */}
      <figure>
        <SmartImage
          src={about.membership.image}
          alt={about.membership.imageAlt[lang]}
          widths={[420, 840]}
          sizes="(min-width: 64rem) 26rem, 100vw"
          class="w-full rounded-[var(--radius-card)] border border-[var(--color-border)] bg-white"
        />
        <figcaption class="mt-2 text-xs text-[var(--color-faint)]">{about.membership.imageAlt[lang]}</figcaption>
      </figure>
    </div>

    <div class="card mt-4 flex flex-wrap items-center justify-between gap-4 p-6">
      <div>
        <h3 class="text-xl">{t('about.charter')}</h3>
        <p class="mt-1 text-sm text-[var(--color-muted)]">{t('about.charterNote')}</p>
      </div>
      <a href={about.charterPdf} class="btn btn-primary" download>{t('common.download')}</a>
    </div>
  </Section>

  <Section eyebrow={t('about.goals')} title={t('about.goals')} id="goals">
    <ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {about.goals.map((goal, index) => (
        <li class="card p-6">
          <span class="ring-num text-[var(--color-accent-text)]">{index + 1}</span>
          <h3 class="mt-4 text-lg">{goal.title[lang]}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{goal.body[lang]}</p>
        </li>
      ))}
    </ol>
  </Section>

  <section class="border-y border-[var(--color-border)] bg-[var(--color-surface)]">
    <div class="wrap py-14 md:py-20">
      <p class="eyebrow">{t('about.safety')}</p>
      <blockquote class="mt-4 max-w-3xl border-s-2 border-[var(--color-accent)] ps-6 text-xl leading-relaxed md:text-2xl">
        {about.safetyStatement[lang]}
      </blockquote>
    </div>
  </section>

  <Section eyebrow={t('about.board')} title={t('about.board')} id="board">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {about.board.map((member) => (
        <li class="card overflow-hidden">
          <SmartImage
            src={member.photo}
            alt={`${member.name}, ${member.role[lang]}`}
            aspect="1/1"
            widths={[480]}
            formats={['webp']}
            sizes="(min-width: 64rem) 22vw, 50vw"
            class="w-full"
          />
          <div class="p-4">
            <p class="font-bold">{member.name}</p>
            <p class="mt-0.5 text-xs uppercase tracking-[0.1em] text-[var(--color-accent-text)]">{member.role[lang]}</p>
          </div>
        </li>
      ))}
    </ul>
  </Section>

</BaseLayout>

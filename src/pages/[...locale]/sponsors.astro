---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import { resolveImage } from '@/lib/images';
import { localePaths, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { breadcrumbLd } from '@/lib/seo';
import { site } from '@/lib/site';
import sponsors from '@/content/config/sponsors.json';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const grouped = sponsors.tiers.map((tier) => ({
  tier,
  items: sponsors.items.filter((item) => item.tier === tier.id),
}));
---

<BaseLayout
  lang={lang}
  neutral="/sponsors"
  title={t('sponsors.title')}
  description={sponsors.pitch[lang]}
  jsonLd={[breadcrumbLd([{ name: t('sponsors.title'), url: localizePath('/sponsors', lang) }])]}
>
  <PageHeader
    lang={lang}
    title={t('sponsors.title')}
    lead={sponsors.pitch[lang]}
    crumbs={[{ name: t('sponsors.title'), path: '/sponsors' }]}
  />

  {grouped.map(({ tier, items }) =>
    items.length > 0 ? (
      <Section eyebrow={tier.label[lang]}>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((sponsor) => {
            const logo = resolveImage(sponsor.logo);
            return (
              <li class="card relative flex flex-col items-start gap-4 p-6">
                {logo ? (
                  <img src={logo.src} alt={sponsor.name} width="160" height="67" loading="lazy" decoding="async" class="h-16 w-auto text-[var(--color-muted)]" />
                ) : (
                  <span class="text-lg font-bold">{sponsor.name}</span>
                )}
                <div>
                  <h2 class="text-lg">
                    <a href={sponsor.url} rel="noopener sponsored" class="after:absolute after:inset-0 hover:text-[var(--color-accent)]">
                      {sponsor.name}
                    </a>
                  </h2>
                  <p class="mt-1 text-sm text-[var(--color-muted)]">{sponsor.blurb[lang]}</p>
                </div>
              </li>
            );
          })}
        </ul>
      </Section>
    ) : null,
  )}

  <section class="border-y border-[var(--color-border)] bg-[var(--color-surface)]">
    <div class="wrap flex flex-col items-start gap-6 py-14 md:flex-row md:items-center md:justify-between">
      <h2 class="max-w-xl text-3xl">{t('sponsors.become')}</h2>
      <a href={site.forms.sponsorship} rel="noopener" class="btn btn-primary">{t('contact.form')}</a>
    </div>
  </section>
</BaseLayout>

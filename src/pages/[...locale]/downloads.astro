---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import { localePaths, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { breadcrumbLd } from '@/lib/seo';
import downloads from '@/content/config/downloads.json';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  neutral="/downloads"
  title={t('downloads.title')}
  description={lang === 'hy'
    ? 'Կանոնագրքեր, միավորի քարտեր և տպելու համար նախատեսված թիրախներ։'
    : 'Rulebooks, score cards and printable targets.'}
  jsonLd={[breadcrumbLd([{ name: t('downloads.title'), url: localizePath('/downloads', lang) }])]}
>
  <PageHeader
    lang={lang}
    title={t('downloads.title')}
    lead={downloads.note[lang]}
    crumbs={[{ name: t('downloads.title'), path: '/downloads' }]}
  />

  {downloads.groups.map((group) => (
    <Section title={group.title[lang]} id={group.id}>
      <ul class="grid gap-3">
        {group.items.map((item) => (
          <li class="card relative flex items-center justify-between gap-4 p-4">
            <div>
              <h3 class="text-base">
                <a href={item.file} download class="after:absolute after:inset-0 hover:text-[var(--color-accent)]">
                  {item.title[lang]}
                </a>
              </h3>
              <p class="mt-0.5 text-xs text-[var(--color-faint)]">{item.note[lang]}</p>
            </div>
            <span class="tag shrink-0">PDF</span>
          </li>
        ))}
      </ul>
    </Section>
  ))}
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PostCard from '@/components/PostCard.astro';
import TagFilter from '@/components/TagFilter.astro';
import { LOCALES, localeParam, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { getPosts } from '@/lib/content';
import { breadcrumbLd } from '@/lib/seo';
import { tagCounts } from '@/lib/news';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LOCALES) {
    const posts = await getPosts(lang);
    for (const { tag } of tagCounts(posts)) {
      paths.push({ params: { locale: localeParam(lang), tag }, props: { lang, tag } });
    }
  }
  return paths;
}

const { lang, tag } = Astro.props as { lang: Lang; tag: string };
const t = useTranslations(lang);

const posts = (await getPosts(lang)).filter((post) => post.data.tags.includes(tag as never));
const counts = tagCounts(await getPosts(lang));
---

<BaseLayout
  lang={lang}
  neutral={`/news/tag/${tag}`}
  title={`${t('news.title')} — #${tag}`}
  description={`${t('news.tags')}: ${tag}`}
  jsonLd={[
    breadcrumbLd([
      { name: t('news.title'), url: localizePath('/news', lang) },
      { name: `#${tag}`, url: localizePath(`/news/tag/${tag}`, lang) },
    ]),
  ]}
>
  <PageHeader
    lang={lang}
    eyebrow={t('news.tags')}
    title={`#${tag}`}
    crumbs={[
      { name: t('news.title'), path: '/news' },
      { name: `#${tag}`, path: `/news/tag/${tag}` },
    ]}
  >
    <div class="mt-6">
      <TagFilter
        active={tag}
        items={[
          { id: '', label: t('common.all'), href: localizePath('/news', lang) },
          ...counts.map((c) => ({
            id: c.tag,
            label: c.tag,
            href: localizePath(`/news/tag/${c.tag}`, lang),
            count: c.count,
          })),
        ]}
      />
    </div>
  </PageHeader>

  <div class="wrap py-14">
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <PostCard
          lang={lang}
          slug={post.slug}
          title={post.data.title}
          excerpt={post.data.excerpt}
          date={post.data.date}
          tags={post.data.tags}
          cover={post.data.cover}
          coverAlt={post.data.coverAlt}
        />
      ))}
    </div>
  </div>
</BaseLayout>

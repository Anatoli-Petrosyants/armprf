---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Leaderboard from '@/components/Leaderboard.astro';
import LiteYouTube from '@/components/LiteYouTube.astro';
import SmartImage from '@/components/SmartImage.astro';
import { LOCALES, localeParam, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { getChallenges } from '@/lib/content';
import { assertResultsValid, getRankedRows } from '@/lib/leaderboard';
import { athleteNames } from '@/lib/athletes';
import { breadcrumbLd } from '@/lib/seo';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LOCALES) {
    for (const challenge of await getChallenges(lang)) {
      paths.push({
        params: { locale: localeParam(lang), challenge: challenge.data.id },
        props: { lang, challenge },
      });
    }
  }
  return paths;
}

const { lang, challenge } = Astro.props;
const t = useTranslations(lang);
await assertResultsValid();

const data = challenge.data;
const { Content } = await render(challenge);
const rows = await getRankedRows(data);
const names = await athleteNames(lang);
const neutral = `/leaderboards/${data.id}`;
const tabs = (await getChallenges(lang)).map((c) => ({ id: c.data.id, title: c.data.title }));
---

<BaseLayout
  lang={lang}
  neutral={neutral}
  title={data.title}
  description={data.summary}
  ogImage={`/og/leaderboards/${data.id}.png`}
  jsonLd={[
    breadcrumbLd([
      { name: t('lb.title'), url: localizePath('/leaderboards', lang) },
      { name: data.title, url: localizePath(neutral, lang) },
    ]),
  ]}
>
  <header class="relative isolate overflow-hidden border-b border-[var(--color-border)]">
    {data.heroImage && (
      <>
        <SmartImage
          src={data.heroImage}
          alt={data.heroAlt ?? data.title}
          aspect="21/9"
          widths={[960, 1600, 2200]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 -z-10 h-full w-full object-cover opacity-45"
        />
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[var(--color-bg)] via-[color-mix(in_srgb,var(--color-bg)_70%,transparent)] to-transparent"></div>
      </>
    )}
    <div class="wrap py-12 md:py-16">
      <Breadcrumbs
        lang={lang}
        items={[
          { name: t('lb.title'), path: '/leaderboards' },
          { name: data.title, path: neutral },
        ]}
      />
      <nav aria-label={t('lb.title')} class="no-scrollbar mt-5 -mx-1 flex gap-2 overflow-x-auto pb-1">
        {tabs.map((tab) => (
          <a
            href={localizePath(`/leaderboards/${tab.id}`, lang)}
            aria-current={tab.id === data.id ? 'page' : undefined}
            class="tag whitespace-nowrap px-3 py-2 hover:border-[var(--color-accent)] hover:text-[var(--color-accent-text)]"
            data-active={tab.id === data.id ? 'true' : 'false'}
          >
            {tab.title}
          </a>
        ))}
      </nav>

      <h1 class="mt-5 max-w-3xl text-4xl leading-tight md:text-5xl">{data.title}</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-muted)]">{data.summary}</p>

      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
        <div>
          <dt class="text-[0.625rem] uppercase tracking-[0.14em] text-[var(--color-faint)]">{t('lb.scoring')}</dt>
          <dd class="mt-1 font-bold">{t(`lb.${data.scoring === 'points' ? 'score' : data.scoring}`)}</dd>
        </div>
        {data.maxScore !== undefined && (
          <div>
            <dt class="text-[0.625rem] uppercase tracking-[0.14em] text-[var(--color-faint)]">{t('lb.maxScore')}</dt>
            <dd class="tnum mt-1 font-bold text-[var(--color-accent-text)]">{data.maxScore}</dd>
          </div>
        )}
        <div>
          <dt class="text-[0.625rem] uppercase tracking-[0.14em] text-[var(--color-faint)]">{t('lb.entries')}</dt>
          <dd class="tnum mt-1 font-bold">{rows.length}</dd>
        </div>
      </dl>

      {data.videoUrl && (
        <div class="mt-8">
          <a href="#video" class="btn btn-ghost">{t('lb.watchVideo')}</a>
        </div>
      )}
    </div>
  </header>


  <section class="wrap pb-12">
    <Leaderboard
      lang={lang}
      challengeId={data.id}
      columns={data.columns}
      rows={rows}
      scoring={data.scoring}
      unit={data.unit}
      seasonal={data.seasonal}
      displayNames={names}
    />
  </section>

  <section
    class:list={[
      'wrap grid gap-10 border-t border-[var(--color-border)] py-12',
      data.videoUrl && 'lg:grid-cols-[1fr_22rem]',
    ]}
  >
    <div class="prose-armprf">
      <h2 class="!mt-0 !border-t-0 !pt-0">{t('lb.rules')}</h2>
      <Content />
      {!challenge.translated && <p class="text-[var(--color-muted)]">{t('common.translationPending')}</p>}
    </div>

    {data.videoUrl && (
      <aside class="grid gap-6">
        <div id="video">
          <h2 class="eyebrow">{t('lb.watchVideo')}</h2>
          <div class="mt-3">
            <LiteYouTube lang={lang} url={data.videoUrl} title={data.title} />
          </div>
        </div>
      </aside>
    )}
  </section>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import { localePaths, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { breadcrumbLd } from '@/lib/seo';
import disciplines from '@/content/config/disciplines.json';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const gs = disciplines.gettingStarted;
---

<BaseLayout
  lang={lang}
  neutral="/getting-started"
  title={t('nav.gettingStarted')}
  description={lang === 'hy'
    ? 'Ինչ է պետք առաջին ճշգրիտ հրաձգության մրցմանը՝ նվազագույն հանդերձանք, անվտանգության կանոններ և առաջին քայլերը։'
    : 'What you need for your first precision rifle match — minimum gear, safety rules and the first steps.'}
  jsonLd={[breadcrumbLd([{ name: t('nav.gettingStarted'), url: localizePath('/getting-started', lang) }])]}
>
  <PageHeader
    lang={lang}
    title={t('nav.gettingStarted')}
    lead={lang === 'hy'
      ? 'Հինգ քայլ՝ դիտորդից մինչև առաջին մրցում։ Ոչ մի քայլ չի պահանջում թանկ սարքավորում։'
      : 'Five steps from spectator to first match. None of them requires expensive equipment.'}
    crumbs={[{ name: t('nav.gettingStarted'), path: '/getting-started' }]}
  />

  <Section>
    <ol class="grid gap-4">
      {gs.steps.map((step, index) => (
        <li class="card flex gap-5 p-6">
          <span class="ring-num shrink-0 text-[var(--color-accent)]">{index + 1}</span>
          <div>
            <h2 class="text-xl">{step.title[lang]}</h2>
            <p class="mt-2 leading-relaxed text-[var(--color-muted)]">{step.body[lang]}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section
    eyebrow={lang === 'hy' ? 'Ստուգաթերթ' : 'Checklist'}
    title={lang === 'hy' ? 'Նվազագույն հանդերձանք' : 'Minimum gear'}
    class="moa-grid"
  >
    <ul class="grid gap-2 md:grid-cols-2">
      {gs.minimumGear[lang].map((item) => (
        <li class="card flex items-start gap-3 p-4 text-sm">
          <span aria-hidden="true" class="mt-0.5 text-[var(--color-accent)]">✓</span>
          <span class="text-[var(--color-muted)]">{item}</span>
        </li>
      ))}
    </ul>
  </Section>

  <Section>
    <div class="flex flex-wrap gap-3">
      <a href={localizePath('/events', lang)} class="btn btn-primary">{t('events.title')}</a>
      <a href={localizePath('/disciplines#glossary', lang)} class="btn btn-ghost">{lang === 'hy' ? 'Տերմիններ' : 'Glossary'}</a>
      <a href={localizePath('/contact', lang)} class="btn btn-ghost">{t('contact.title')}</a>
    </div>
  </Section>
</BaseLayout>

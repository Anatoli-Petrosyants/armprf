---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import { localePaths, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { breadcrumbLd } from '@/lib/seo';
import disciplines from '@/content/config/disciplines.json';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  neutral="/disciplines"
  title={t('nav.disciplines')}
  description={lang === 'hy'
    ? 'Ճշգրիտ հրաձգության ուղղությունները ARMPRF-ում՝ հեռահար, rimfire, որսորդական, KYL և դաշտային դիրքային։'
    : 'The precision rifle disciplines at ARMPRF — long range, rimfire, hunter, KYL and field positional.'}
  jsonLd={[breadcrumbLd([{ name: t('nav.disciplines'), url: localizePath('/disciplines', lang) }])]}
>
  <PageHeader
    lang={lang}
    title={t('nav.disciplines')}
    crumbs={[{ name: t('nav.disciplines'), path: '/disciplines' }]}
  />

  <Section>
    <ul class="grid gap-4 md:grid-cols-2">
      {disciplines.items.map((item) => (
        <li class="card p-6" id={item.id}>
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-2xl">{item.title[lang]}</h2>
            <span class="tnum tag whitespace-nowrap">{item.distance}</span>
          </div>
          <p class="mt-3 leading-relaxed text-[var(--color-muted)]">{item.summary[lang]}</p>
          <p class="mt-4 border-t border-[var(--color-border)] pt-3 text-sm text-[var(--color-faint)]">
            <span class="eyebrow">{lang === 'hy' ? 'Հանդերձանք' : 'Gear'}</span><br />
            {item.gear[lang]}
          </p>
        </li>
      ))}
    </ul>
  </Section>

  <Section title={lang === 'hy' ? 'Տերմիններ' : 'Glossary'} id="glossary" class="moa-grid">
    <dl class="grid gap-3 md:grid-cols-2">
      {disciplines.glossary.map((entry) => (
        <div class="card p-4">
          <dt class="font-bold text-[var(--color-accent)]">{entry.term}</dt>
          <dd class="mt-1 text-sm leading-relaxed text-[var(--color-muted)]">{entry[lang]}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section>
    <a href={localizePath('/getting-started', lang)} class="btn btn-primary">{t('nav.gettingStarted')} →</a>
  </Section>
</BaseLayout>

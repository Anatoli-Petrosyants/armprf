---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import AthleteCard from '@/components/AthleteCard.astro';
import Pagination from '@/components/Pagination.astro';
import { LOCALES, localeParam, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { PER_PAGE, getRoster } from '@/lib/athletes';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LOCALES) {
    const athletes = await getRoster(lang);
    const total = Math.max(1, Math.ceil(athletes.length / PER_PAGE));
    // Page 1 lives at /athletes, so only 2..n get their own route.
    for (let page = 2; page <= total; page += 1) {
      paths.push({
        params: { locale: localeParam(lang), page: String(page) },
        props: { lang, page, total },
      });
    }
  }
  return paths;
}

const { lang, page, total } = Astro.props as { lang: Lang; page: number; total: number };
const t = useTranslations(lang);

const athletes = await getRoster(lang);
const items = athletes.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const prev = page === 2 ? localizePath('/athletes', lang) : localizePath(`/athletes/page/${page - 1}`, lang);
const next = page < total ? localizePath(`/athletes/page/${page + 1}`, lang) : undefined;
---

<BaseLayout
  lang={lang}
  neutral={`/athletes/page/${page}`}
  title={`${t('athletes.title')} · ${t('common.page')} ${page}`}
  description={`${t('athletes.title')} · ${t('common.page')} ${page} ${t('common.of')} ${total}`}
  noindex={true}
>
  <PageHeader
    lang={lang}
    title={t('athletes.title')}
    count={athletes.length}
    crumbs={[{ name: t('athletes.title'), path: '/athletes' }]}
  />

  <div class="wrap py-14">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5">
      {items.map((athlete) => (
        <li>
          <AthleteCard
            lang={lang}
            name={athlete.data.name}
            photo={athlete.data.photo}
            photoAlt={athlete.data.photoAlt}
            hometown={athlete.data.hometown}
            memberSince={athlete.data.memberSince}
          />
        </li>
      ))}
    </ul>

    <Pagination lang={lang} current={page} total={total} prev={prev} next={next} />
  </div>
</BaseLayout>

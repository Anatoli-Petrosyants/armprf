---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SmartImage from '@/components/SmartImage.astro';
import { LOCALES, localeParam, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { getAthletes, getChallenges } from '@/lib/content';
import { getRankedRows } from '@/lib/leaderboard';
import { formatDateShort, formatTime } from '@/lib/format';
import { breadcrumbLd } from '@/lib/seo';
import { flag } from '@/lib/site';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LOCALES) {
    for (const athlete of await getAthletes(lang)) {
      paths.push({
        params: { locale: localeParam(lang), slug: athlete.data.slug },
        props: { lang, athlete },
      });
    }
  }
  return paths;
}

const { lang, athlete } = Astro.props;
const t = useTranslations(lang);
const data = athlete.data;
const { Content } = await render(athlete);
const neutral = `/athletes/${data.slug}`;

// Results are recorded under the Latin spelling; match on both language files.
const latin = (await getAthletes('en')).find((a) => a.data.slug === data.slug);
const keys = new Set([data.name.trim().toLowerCase(), latin?.data.name.trim().toLowerCase()].filter(Boolean));

const challenges = await getChallenges(lang);
const appearances = [];
for (const challenge of challenges) {
  const rows = await getRankedRows(challenge.data);
  const mine = rows.filter((row) => keys.has(row.name.trim().toLowerCase()));
  if (mine.length) appearances.push({ challenge, rows: mine });
}

const roster = await getAthletes(lang);
const showClub = new Set(roster.map((a) => a.data.club)).size > 1;

const facts = [
  ...(showClub ? [{ label: t('athletes.club'), value: data.club }] : []),
  { label: t('athletes.division'), value: data.divisions.join(' · ') },
  { label: t('athletes.since'), value: String(data.memberSince) },
  ...(data.hometown ? [{ label: t('common.location'), value: data.hometown }] : []),
  ...(data.rifle ? [{ label: t('lb.rifle'), value: data.rifle }] : []),
  ...(data.caliber ? [{ label: t('lb.caliber'), value: data.caliber }] : []),
];

function display(row: { score?: number; hits?: number; percent?: number; time?: number }, scoring: string, unit?: string) {
  if (scoring === 'time' && row.time !== undefined) return formatTime(row.time);
  if (scoring === 'percent' && row.percent !== undefined) return `${row.percent}%`;
  if (scoring === 'hits' && row.hits !== undefined) return String(row.hits);
  return row.score !== undefined ? `${row.score}${unit ? ` ${unit}` : ''}` : '—';
}
---

<BaseLayout
  lang={lang}
  neutral={neutral}
  title={data.name}
  description={`${data.name} — ${data.club}, ${data.divisions.join(', ')}`}
  jsonLd={[
    breadcrumbLd([
      { name: t('athletes.title'), url: localizePath('/athletes', lang) },
      { name: data.name, url: localizePath(neutral, lang) },
    ]),
  ]}
>
  <div class="wrap py-10">
    <Breadcrumbs
      lang={lang}
      items={[
        { name: t('athletes.title'), path: '/athletes' },
        { name: data.name, path: neutral },
      ]}
    />
  </div>

  <div class="wrap grid gap-10 pb-14 lg:grid-cols-[18rem_1fr]">
    <aside>
      {flag('showAthletePhotos') && (
        <SmartImage
          src={data.photo}
          alt={data.photoAlt ?? data.name}
          aspect="1/1"
          widths={[320, 640]}
          sizes="(min-width: 64rem) 18rem, 100vw"
          class="w-full rounded-[var(--radius-card)] border border-[var(--color-border)]"
        />
      )}
      <dl class="card mt-4 divide-y divide-[var(--color-border)]">
        {facts.map((fact) => (
          <div class="p-4">
            <dt class="text-[0.625rem] uppercase tracking-[0.14em] text-[var(--color-faint)]">{fact.label}</dt>
            <dd class="mt-1 text-sm">{fact.value}</dd>
          </div>
        ))}
      </dl>
      {data.instagram && (
        <a href={data.instagram} rel="noopener" class="btn btn-ghost mt-4 w-full">Instagram ↗</a>
      )}
    </aside>

    <div>
      <h1 class="text-4xl md:text-5xl">{data.name}</h1>
      {data.bestFinishes.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {data.bestFinishes.map((finish) => (
            <li class="tag border-[var(--color-accent)] text-[var(--color-accent-text)]">{finish}</li>
          ))}
        </ul>
      )}

      <div class="prose-armprf mt-6">
        <Content />
      </div>

      {appearances.length > 0 && (
        <section class="mt-12">
          <h2 class="eyebrow">{t('athletes.results')}</h2>
          <div class="mt-4 grid gap-4">
            {appearances.map(({ challenge, rows }) => (
              <div class="card overflow-hidden">
                <div class="flex items-center justify-between gap-3 border-b border-[var(--color-border)] bg-[var(--color-surface-2)] px-4 py-2.5">
                  <a href={localizePath(`/leaderboards/${challenge.data.id}`, lang)} class="text-sm font-bold hover:text-[var(--color-accent-text)]">
                    {challenge.data.title}
                  </a>
                  <span class="tnum text-xs text-[var(--color-faint)]">{rows.length} {t('lb.attempts')}</span>
                </div>
                <ul class="divide-y divide-[var(--color-border)]">
                  {rows.map((row) => (
                    <li class="flex items-center justify-between gap-4 px-4 py-2.5 text-sm">
                      <span class="tnum w-10 shrink-0 font-bold text-[var(--color-accent-text)]">#{row.rank}</span>
                      <span class="flex-1 text-[var(--color-muted)]">{formatDateShort(row.date, lang)}</span>
                      <span class="tnum font-bold">{display(row, challenge.data.scoring, challenge.data.unit)}</span>
                      {row.verified && <span class="tag border-[var(--color-accent)] text-[var(--color-accent-text)]">✓</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

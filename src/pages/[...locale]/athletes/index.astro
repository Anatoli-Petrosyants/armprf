---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import AthleteCard from '@/components/AthleteCard.astro';
import Pagination from '@/components/Pagination.astro';
import { localePaths, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { PER_PAGE, getRoster } from '@/lib/athletes';
import { breadcrumbLd } from '@/lib/seo';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const athletes = await getRoster(lang);
const pageItems = athletes.slice(0, PER_PAGE);
const totalPages = Math.max(1, Math.ceil(athletes.length / PER_PAGE));
---

<BaseLayout
  lang={lang}
  neutral="/athletes"
  title={t('athletes.title')}
  description={lang === 'hy'
    ? 'ARMPRF-ի մարզիկները՝ լուսանկար, անուն, քաղաք և ֆեդերացիայում անդամակցության տարին։'
    : 'The ARMPRF roster: photograph, name, city and the year each shooter joined.'}
  jsonLd={[breadcrumbLd([{ name: t('athletes.title'), url: localizePath('/athletes', lang) }])]}
>
  <PageHeader lang={lang} title={t('athletes.title')} crumbs={[{ name: t('athletes.title'), path: '/athletes' }]} />

  <div class="wrap py-14">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5">
      {pageItems.map((athlete) => (
        <li>
          <AthleteCard
            lang={lang}
            name={athlete.data.name}
            photo={athlete.data.photo}
            photoAlt={athlete.data.photoAlt}
            hometown={athlete.data.hometown}
            memberSince={athlete.data.memberSince}
          />
        </li>
      ))}
    </ul>

    <Pagination
      lang={lang}
      current={1}
      total={totalPages}
      next={totalPages > 1 ? localizePath('/athletes/page/2', lang) : undefined}
    />
  </div>
</BaseLayout>

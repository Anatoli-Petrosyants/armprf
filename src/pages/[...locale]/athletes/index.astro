---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import AthleteCard from '@/components/AthleteCard.astro';
import { localePaths, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { getAthletes } from '@/lib/content';
import { breadcrumbLd } from '@/lib/seo';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const athletes = await getAthletes(lang);
---

<BaseLayout
  lang={lang}
  neutral="/athletes"
  title={t('athletes.title')}
  description={lang === 'hy'
    ? 'ARMPRF-ի մարզիկները՝ ակումբ, դասակարգ, հրացան և արդյունքներ աղյուսակներում։'
    : 'ARMPRF shooters — club, division, rifle, and their leaderboard results.'}
  jsonLd={[breadcrumbLd([{ name: t('athletes.title'), url: localizePath('/athletes', lang) }])]}
>
  <PageHeader lang={lang} title={t('athletes.title')} crumbs={[{ name: t('athletes.title'), path: '/athletes' }]} />

  <div class="wrap py-14">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5">
      {athletes.map((athlete) => (
        <li>
          <AthleteCard
            lang={lang}
            slug={athlete.data.slug}
            name={athlete.data.name}
            club={athlete.data.club}
            divisions={athlete.data.divisions}
            photo={athlete.data.photo}
            photoAlt={athlete.data.photoAlt}
            bestFinishes={athlete.data.bestFinishes}
          />
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

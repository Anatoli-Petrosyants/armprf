---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import PostCard from '@/components/PostCard.astro';
import Leaderboard from '@/components/Leaderboard.astro';
import SmartImage from '@/components/SmartImage.astro';
import { localePaths, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { getChallenges, getPosts } from '@/lib/content';
import { assertResultsValid, getRankedRows } from '@/lib/leaderboard';
import { athleteNames } from '@/lib/athletes';
import { site, siteName } from '@/lib/site';
import home from '@/content/config/home.json';

export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

await assertResultsValid();

const posts = (await getPosts(lang)).slice(0, 2);

const challenges = await getChallenges(lang);
const featured = challenges.find((c) => c.data.id === site.featuredChallenge) ?? challenges[0];
const featuredRows = featured ? await getRankedRows(featured.data) : [];
const names = await athleteNames(lang);
/** The teaser mirrors the full table: rank, name and score are always there,
 *  and the rest show only when the challenge itself declares them. */
const TEASER_OPTIONAL = new Set(['division', 'rifle', 'caliber', 'date']);
const featuredColumns = ['rank', 'name', 'division', 'rifle', 'caliber', 'score', 'date'].filter(
  (column) => !TEASER_OPTIONAL.has(column) || Boolean(featured?.data.columns.includes(column)),
);

const icons: Record<string, string> = {
  reticle: 'M12 2v5M12 17v5M2 12h5M17 12h5',
  shield: 'M12 3l7 3v6c0 4.4-3 8.2-7 9-4-.8-7-4.6-7-9V6z',
  chart: 'M4 20V9M10 20V4M16 20v-7M22 20H2',
  // An open book: the pages meet at the spine, so it reads at 26px.
  education: 'M12 7.5v12M12 7.5C10.6 6.2 8.8 5.5 7 5.5H3v12h4c1.8 0 3.6.7 5 2M12 7.5c1.4-1.3 3.2-2 5-2h4v12h-4c-1.8 0-3.6.7-5 2',
};
---

<BaseLayout
  lang={lang}
  neutral="/"
  title={siteName(lang)}
  description={site.description[lang]}
>
  <section class="relative isolate overflow-hidden border-b border-[var(--color-border)]">
    <SmartImage
      src={site.hero.image}
      alt={site.hero.alt[lang]}
      widths={[960, 1600, 2560]}
      sizes="100vw"
      aspect="16/9"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover [object-position:right_center]"
    />
    {/* The scrim has to carry the heading in both themes, so it stays strong
        across the text column and only thins out past it. */}
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-[var(--color-bg)] from-15% via-[color-mix(in_srgb,var(--color-bg)_88%,transparent)] via-45% to-[color-mix(in_srgb,var(--color-bg)_8%,transparent)]"
    >
    </div>

    <div class="wrap flex min-h-[clamp(30rem,72dvh,44rem)] flex-col justify-center py-20">
      <p class="eyebrow">{site.shortName}</p>
      <h1 class="mt-4 max-w-3xl text-[clamp(2rem,5.5vw,3.75rem)] leading-[1.02]">
        {siteName(lang)}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[var(--color-muted)]">
        {site.description[lang]}
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={localizePath('/blog', lang)} class="btn btn-primary">{t('nav.blog')}</a>
        <a href={localizePath('/leaderboards', lang)} class="btn btn-ghost">{t('home.hero.secondary')}</a>
      </div>
    </div>
  </section>

  <Section eyebrow={t('home.mission.eyebrow')} title={t('home.mission.title')}>
    <ul class="grid gap-4 md:grid-cols-3">
      {home.missionTiles.map((tile) => (
        <li class="card p-6">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="var(--color-accent)" stroke-width="1.6" aria-hidden="true">
            {tile.icon === 'reticle' && <circle cx="12" cy="12" r="7" />}
            <path d={icons[tile.icon]} />
          </svg>
          <h3 class="mt-4 text-xl">{tile.title[lang]}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{tile.body[lang]}</p>
        </li>
      ))}
    </ul>
  </Section>

  <div class="arc-divider"></div>

  {featured && featuredRows.length > 0 && (
    <Section
      eyebrow={t('home.leaderboard.eyebrow')}
      title={featured.data.title}
      href={localizePath(`/leaderboards/${featured.data.id}`, lang)}
      linkLabel={t('home.leaderboard.viewFull')}
      class="moa-grid"
    >
      <Leaderboard
        lang={lang}
        challengeId={featured.data.id}
        columns={featuredColumns}
        rows={featuredRows}
        scoring={featured.data.scoring}
        unit={featured.data.unit}
        displayNames={names}
        limit={5}
      />
    </Section>
  )}

  <Section
    eyebrow={t('home.news.eyebrow')}
    title={t('news.title')}
    href={localizePath('/blog', lang)}
    linkLabel={t('common.viewAll')}
  >
    <div class="grid gap-4 md:grid-cols-2">
      {posts.map((post) => (
        <PostCard
          lang={lang}
          slug={post.slug}
          title={post.data.title}
          excerpt={post.data.excerpt}
          date={post.data.date}
          tags={post.data.tags}
          cover={post.data.cover}
          coverAlt={post.data.coverAlt}
        />
      ))}
    </div>
  </Section>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import { localePaths, localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { breadcrumbLd } from '@/lib/seo';
import { flag } from '@/lib/site';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const open = flag('showShop');
---

<BaseLayout
  lang={lang}
  neutral="/shop"
  title={t('shop.title')}
  description={t('shop.closed')}
  noindex={!open}
>
  <PageHeader lang={lang} title={t('shop.title')} crumbs={[{ name: t('shop.title'), path: '/shop' }]} />
  <Section>
    <div class="card moa-grid grid place-items-center p-16 text-center">
      <p class="eyebrow">{t('common.comingSoon')}</p>
      <p class="mt-3 max-w-md text-[var(--color-muted)]">{t('shop.closed')}</p>
      <a href={localizePath('/contact', lang)} class="btn btn-ghost mt-6">{t('contact.title')}</a>
    </div>
  </Section>
</BaseLayout>

---
import { Image, Picture } from 'astro:assets';
import { resolveImage } from '@/lib/images';

interface Props {
  src: string | undefined;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  aspect?: string;
  /** Output formats. A single entry ships one file per width, no <picture>. */
  formats?: Array<'avif' | 'webp' | 'jpeg' | 'png'>;
}

const {
  src,
  alt,
  widths = [480, 800, 1200],
  sizes = '(min-width: 64rem) 33vw, 100vw',
  class: className = '',
  loading = 'lazy',
  fetchpriority = 'auto',
  aspect,
  formats = ['avif', 'webp'],
} = Astro.props;

const image = resolveImage(src);
// Never ask sharp to upscale, but do keep the source's own width as the top
// step — otherwise a 1440px photo asked for [960, 1600, 2560] would ship only
// 960w and look soft on any desktop.
const smaller = image ? widths.filter((w) => w < image.width) : [];
const finalWidths = image
  ? [...new Set([...smaller, ...(widths.some((w) => w >= image.width) ? [image.width] : [])])].sort(
      (a, b) => a - b,
    )
  : [];
---
{
  image && formats.length === 1 ? (
    <Image
      src={image}
      alt={alt}
      width={finalWidths.at(-1) ?? image.width}
      format={formats[0]}
      quality={72}
      loading={loading}
      decoding={loading === 'eager' ? 'sync' : 'async'}
      fetchpriority={fetchpriority}
      class={className}
      style={aspect ? `aspect-ratio:${aspect};object-fit:cover` : undefined}
    />
  ) : image ? (
    <Picture
      src={image}
      alt={alt}
      widths={finalWidths}
      sizes={sizes}
      formats={formats}
      fallbackFormat="jpeg"
      quality={72}
      loading={loading}
      decoding={loading === 'eager' ? 'sync' : 'async'}
      fetchpriority={fetchpriority}
      class={className}
      style={aspect ? `aspect-ratio:${aspect};object-fit:cover` : undefined}
    />
  ) : (
    <div
      class={`moa-grid grid place-items-center bg-[var(--color-surface-2)] text-[0.625rem] uppercase tracking-[0.2em] text-[var(--color-faint)] ${className}`}
      style={aspect ? `aspect-ratio:${aspect}` : 'aspect-ratio:3/2'}
      role="img"
      aria-label={alt}
    >
      TODO(content)
    </div>
  )
}

---
import { youtubeId } from '@/lib/format';
import type { Lang } from '@/lib/i18n';

interface Props {
  lang: Lang;
  url: string;
  title: string;
  class?: string;
}
const { lang, url, title, class: className = '' } = Astro.props;
const id = youtubeId(url);
---
{
  id ? (
    <figure class={className}>
      {/* The real YouTube player, so one tap plays the video in every browser. */}
      <div class="relative aspect-video w-full overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface-2)]">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${id}?rel=0&playsinline=1&hl=${lang}`}
          title={title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
          loading="lazy"
          class="absolute inset-0 h-full w-full border-0"
        />
      </div>
      <figcaption class="mt-2 text-sm text-[var(--color-muted)]">{title}</figcaption>
    </figure>
  ) : (
    <p class="text-sm text-[var(--color-faint)]">TODO(content): {title}</p>
  )
}

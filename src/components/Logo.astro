---
// The federation wordmark, inlined so it inherits the theme: the lettering that
// is white on dark follows currentColor, while the three brand colours in the
// ARMPRF monogram stay fixed in both themes.
import full from '@/assets/img/brand/logo/armprf-logo-themed.svg?raw';
import compact from '@/assets/img/brand/logo/armprf-wordmark-themed.svg?raw';

interface Props {
  class?: string;
  /** `full` includes the federation name and rule; `compact` is the monogram only. */
  variant?: 'full' | 'compact';
  label?: string;
}
const { class: className = '', variant = 'full', label = 'ARMPRF' } = Astro.props;
const markup = variant === 'full' ? full : compact;
---
<span class={`armprf-logo inline-block ${className}`} role="img" aria-label={label}>
  <Fragment set:html={markup} />
</span>

<style>
  .armprf-logo :global(svg) {
    display: block;
    height: 100%;
    width: auto;
  }
</style>

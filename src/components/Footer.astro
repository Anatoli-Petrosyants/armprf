---
import Logo from '@/components/Logo.astro';
import { localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { nav, site, siteName, slogan, socialLinks, visibleNav } from '@/lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getUTCFullYear();
const links = visibleNav(nav.footer);
---

<footer class="mt-24 border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div class="wrap grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo class="h-12" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-[var(--color-muted)]">
        {siteName(lang)}
      </p>
      <p class="mt-1 text-sm text-[var(--color-muted)]">{slogan(lang)}</p>
      <ul class="mt-5 flex flex-wrap gap-3 text-sm">
        {socialLinks.map((link) => (
          <li>
            <a
              href={link.url}
              rel="me noopener"
              class="text-[var(--color-muted)] underline-offset-4 hover:text-[var(--color-accent-text)] hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav aria-label={t('nav.menu')}>
      <h2 class="eyebrow">{t('nav.menu')}</h2>
      <ul class="mt-4 grid gap-2 text-sm">
        {links.map((item) => (
          <li>
            <a
              href={localizePath(item.path, lang)}
              class="text-[var(--color-muted)] hover:text-[var(--color-ink)]"
            >
              {t(item.key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="eyebrow">{t('contact.title')}</h2>
      <ul class="mt-4 grid gap-2 text-sm text-[var(--color-muted)]">
        <li><a href={`mailto:${site.contact.email}`} class="hover:text-[var(--color-ink)]">{site.contact.email}</a></li>
        <li><a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="hover:text-[var(--color-ink)]">{site.contact.phoneDisplay}</a></li>
        <li>{site.contact.address[lang]}</li>
      </ul>
    </div>
  </div>

  <div class="arc-divider"></div>

  <div class="wrap flex flex-col gap-2 py-6 text-xs text-[var(--color-faint)] sm:flex-row sm:items-center sm:justify-between">
    <p>© {site.foundingYear}–{year} {site.shortName}. {t('footer.rights')}</p>
    <p>{t('footer.built')}</p>
  </div>
</footer>

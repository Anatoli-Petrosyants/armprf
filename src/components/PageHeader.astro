---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import type { Lang } from '@/lib/i18n';

interface Props {
  lang: Lang;
  eyebrow?: string;
  title: string;
  lead?: string;
  /** Optional tally shown beside the heading, e.g. the number of athletes on the roster. */
  count?: number;
  crumbs?: Array<{ name: string; path: string }>;
}
const { lang, eyebrow, title, lead, count, crumbs = [] } = Astro.props;
---
<section class="moa-grid border-b border-[var(--color-border)]">
  <div class="wrap py-12 md:py-16">
    {crumbs.length > 0 && <Breadcrumbs lang={lang} items={crumbs} />}
    {eyebrow && <p class="eyebrow mt-4">{eyebrow}</p>}
    <h1 class="mt-2 flex flex-wrap items-baseline gap-3 text-4xl md:text-5xl">
      {title}
      {count !== undefined && <span class="tabular-nums text-[var(--color-muted)]">({count})</span>}
    </h1>
    {lead && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-muted)]">{lead}</p>}
    <slot />
  </div>
</section>

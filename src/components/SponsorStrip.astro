---
import { resolveImage } from '@/lib/images';
import sponsors from '@/content/config/sponsors.json';
import type { Lang } from '@/lib/i18n';

interface Props {
  lang: Lang;
  limit?: number;
}
const { lang, limit } = Astro.props;
const items = limit ? sponsors.items.slice(0, limit) : sponsors.items;
---
<ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
  {items.map((sponsor) => {
    const logo = resolveImage(sponsor.logo);
    return (
      <li>
        <a
          href={sponsor.url}
          rel="noopener sponsored"
          class="block text-[var(--color-faint)] opacity-70 transition-opacity hover:opacity-100 hover:text-[var(--color-ink)]"
          title={sponsor.blurb[lang]}
        >
          {logo ? (
            <img src={logo.src} alt={sponsor.name} width="140" height="58" loading="lazy" decoding="async" class="h-[58px] w-auto" />
          ) : (
            <span class="text-sm font-bold uppercase tracking-[0.12em]">{sponsor.name}</span>
          )}
        </a>
      </li>
    );
  })}
</ul>

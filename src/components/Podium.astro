---
import { useTranslations, type Lang } from '@/lib/i18n';
import { formatTime } from '@/lib/format';
import type { RankedRow } from '@/lib/leaderboard';

interface Props {
  lang: Lang;
  rows: RankedRow[];
  scoring: 'points' | 'hits' | 'time' | 'percent';
  unit?: string;
}
const { lang, rows, scoring, unit } = Astro.props;
const t = useTranslations(lang);

const top = rows.filter((r) => r.rank <= 3).slice(0, 6);
// Visual order puts the winner in the middle on wide screens.
const order = [2, 1, 3];

function display(row: RankedRow): string {
  if (scoring === 'time' && row.time !== undefined) return formatTime(row.time);
  if (scoring === 'percent' && row.percent !== undefined) return `${row.percent}%`;
  if (scoring === 'hits' && row.hits !== undefined) return String(row.hits);
  return row.score !== undefined ? `${row.score}${unit ? ` ${unit}` : ''}` : '—';
}
---
{
  top.length > 0 && (
    <div>
      <h2 class="eyebrow">{t('lb.podium')}</h2>
      <ol class="mt-4 grid gap-3 sm:grid-cols-3">
        {order.map((place) => {
          const row = top.find((r) => r.rank === place);
          if (!row) return null;
          const first = place === 1;
          return (
            <li
              class={`card flex flex-col items-center p-5 text-center ${first ? 'border-[var(--color-accent)] sm:-mt-3 sm:pb-8' : ''}`}
            >
              <span class={`ring-num ${first ? 'border-[var(--color-accent)] text-[var(--color-accent)]' : ''}`}>{place}</span>
              <p class="mt-3 text-lg font-bold leading-tight">{row.name}</p>
              {row.club && <p class="mt-0.5 text-xs text-[var(--color-faint)]">{row.club}</p>}
              <p class={`tnum mt-3 text-2xl font-bold ${first ? 'text-[var(--color-accent)]' : ''}`}>{display(row)}</p>
              {row.verified && (
                <span class="tag mt-3 border-[var(--color-accent)] text-[var(--color-accent)]">✓ {t('lb.verified')}</span>
              )}
            </li>
          );
        })}
      </ol>
    </div>
  )
}

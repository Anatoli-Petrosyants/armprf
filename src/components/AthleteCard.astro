---
import SmartImage from '@/components/SmartImage.astro';
import { useTranslations, type Lang } from '@/lib/i18n';
import { flag } from '@/lib/site';

interface Props {
  lang: Lang;
  name: string;
  photo?: string;
  photoAlt?: string;
  hometown?: string;
  memberSince: number;
}
const { lang, name, photo, photoAlt, hometown, memberSince } = Astro.props;
const t = useTranslations(lang);
---
<article class="card overflow-hidden">
  {flag('showAthletePhotos') && (
    <SmartImage
      src={photo}
      alt={photoAlt ?? name}
      aspect="1/1"
      widths={[480]}
      formats={['webp']}
      sizes="(min-width: 64rem) 20vw, (min-width: 40rem) 33vw, 50vw"
      class="w-full"
    />
  )}
  <div class="p-4">
    <h3 class="text-base leading-snug">{name}</h3>
    {hometown && <p class="mt-1 text-xs text-[var(--color-faint)]">{hometown}</p>}
    <p class="tnum mt-3 border-t border-[var(--color-border)] pt-2 text-xs text-[var(--color-muted)]">
      <span class="text-[var(--color-faint)]">{t('athletes.since')}: </span>{memberSince}
    </p>
  </div>
</article>

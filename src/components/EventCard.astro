---
import SmartImage from '@/components/SmartImage.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { localizePath, useTranslations, type Lang } from '@/lib/i18n';
import { formatDate } from '@/lib/format';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  summary: string;
  date: Date;
  endDate?: Date;
  location: string;
  discipline: string;
  distanceMin: number;
  distanceMax: number;
  distanceUnit: string;
  status: 'open' | 'full' | 'closed' | 'completed';
  cover?: string;
  coverAlt?: string;
  compact?: boolean;
}
const {
  lang, slug, title, summary, date, endDate, location, discipline,
  distanceMin, distanceMax, distanceUnit, status, cover, coverAlt, compact = false,
} = Astro.props;
const t = useTranslations(lang);
const href = localizePath(`/events/${slug}`, lang);
const day = date.getUTCDate();
const month = new Intl.DateTimeFormat(lang === 'hy' ? 'hy-AM' : 'en', { month: 'short', timeZone: 'UTC' }).format(date);
---
<article class="card relative flex overflow-hidden transition-colors hover:border-[var(--color-border-strong)]">
  {!compact && (
    <div class="hidden w-44 shrink-0 sm:block">
      <SmartImage
        src={cover}
        alt={coverAlt ?? ''}
        aspect="3/4"
        widths={[220, 440]}
        sizes="176px"
        class="h-full w-full object-cover"
      />
    </div>
  )}
  <div class="flex flex-1 gap-4 p-5">
    <div class="shrink-0 text-center">
      <div class="tnum text-3xl font-bold leading-none text-[var(--color-accent)]">{day}</div>
      <div class="mt-1 text-[0.6875rem] uppercase tracking-[0.12em] text-[var(--color-faint)]">{month}</div>
      <div class="tnum mt-0.5 text-[0.6875rem] text-[var(--color-faint)]">{date.getUTCFullYear()}</div>
    </div>
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <StatusBadge lang={lang} status={status} />
        <span class="text-[0.6875rem] uppercase tracking-[0.1em] text-[var(--color-faint)]">{discipline}</span>
      </div>
      <h3 class="mt-2 text-xl leading-snug">
        <a href={href} class="after:absolute after:inset-0 hover:text-[var(--color-accent)]">{title}</a>
      </h3>
      <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-[var(--color-muted)]">{summary}</p>
      <dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-[var(--color-faint)]">
        <div class="flex gap-1.5">
          <dt class="sr-only">{t('common.location')}</dt>
          <dd>{location}</dd>
        </div>
        <div class="flex gap-1.5">
          <dt class="sr-only">{t('events.distance')}</dt>
          <dd class="tnum">{distanceMin}–{distanceMax} {distanceUnit}</dd>
        </div>
        {endDate && (
          <div class="flex gap-1.5">
            <dt class="sr-only">{t('common.date')}</dt>
            <dd>→ {formatDate(endDate, lang, { month: 'short', day: 'numeric' })}</dd>
          </div>
        )}
      </dl>
    </div>
  </div>
</article>
